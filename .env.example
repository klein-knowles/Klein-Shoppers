NODE_ENV=production
PORT=5000

DB_HOST=localhost
DB_USER=klein_shoppers_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=klein_shoppers
DB_POOL_LIMIT=10

SESSION_SECRET=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_NAME=klein.sid
SESSION_SECURE=true
SESSION_MAX_AGE=86400000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-app-password

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

YO_USERNAME=
YO_PASSWORD=
YO_SUBSCRIPTION_KEY=
YO_ENVIRONMENT=sandbox
YO_BASE_URL=

JSON_LIMIT=1mb
FORM_LIMIT=1mb
VIDEO_UPLOAD_LIMIT_MB=100
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
